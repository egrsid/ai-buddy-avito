{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-buddy.invalid/contracts/v1.schema.json",
  "title": "AI-buddy v1 shared payloads",
  "$defs": {
    "TaskStatus": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "blocked",
        "done"
      ]
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "role": {
          "type": "string",
          "enum": [
            "intern",
            "buddy"
          ]
        },
        "team": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "buddy_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "account_id",
        "display_name",
        "role",
        "team",
        "buddy_id"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "status",
        "position",
        "source_ids",
        "version",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "Conversation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "task_id",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "url": {
          "type": "string",
          "pattern": "^/api/v1/knowledge/[0-9a-f-]{36}$"
        },
        "excerpt": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        }
      },
      "required": [
        "document_id",
        "title",
        "url",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100000
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "role",
        "content",
        "status",
        "run_id",
        "sources",
        "created_at"
      ],
      "additionalProperties": false
    },
    "RunRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "content"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "retry_of": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "retry_of"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_message_id": {
          "type": "string",
          "format": "uuid"
        },
        "assistant_message_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "user_message_id",
        "assistant_message_id",
        "status",
        "error_code",
        "action_ids",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "AccessParameters": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "enum": [
            "sandbox/backend",
            "sandbox/restricted"
          ]
        },
        "access_level": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "resource",
        "access_level",
        "reason"
      ],
      "additionalProperties": false
    },
    "EscalationParameters": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "question",
        "summary",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "TaskParameters": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "status",
        "version"
      ],
      "additionalProperties": false
    },
    "ActionDraft": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "create_access_request",
            "escalate_to_buddy",
            "update_task_status"
          ]
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "conversation_id",
        "task_id",
        "type",
        "parameters"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "create_access_request"
            },
            "parameters": {
              "$ref": "#/$defs/AccessParameters"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "escalate_to_buddy"
            },
            "parameters": {
              "$ref": "#/$defs/EscalationParameters"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "update_task_status"
            },
            "parameters": {
              "$ref": "#/$defs/TaskParameters"
            },
            "task_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      ]
    },
    "Action": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "create_access_request",
            "escalate_to_buddy",
            "update_task_status"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending_confirmation",
            "executing",
            "succeeded",
            "failed",
            "unknown",
            "cancelled",
            "expired"
          ]
        },
        "preview": {
          "type": "object"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "conversation_id",
        "task_id",
        "type",
        "parameters",
        "id",
        "status",
        "preview",
        "expires_at",
        "created_at",
        "result",
        "error_code"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "create_access_request"
            },
            "parameters": {
              "$ref": "#/$defs/AccessParameters"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "escalate_to_buddy"
            },
            "parameters": {
              "$ref": "#/$defs/EscalationParameters"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "update_task_status"
            },
            "parameters": {
              "$ref": "#/$defs/TaskParameters"
            },
            "task_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      ]
    },
    "GenerateRequest": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "user": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "team": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "id",
            "team"
          ],
          "additionalProperties": false
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "task": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "status": {
                  "$ref": "#/$defs/TaskStatus"
                }
              },
              "required": [
                "id",
                "title",
                "description",
                "status"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 21,
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 0,
                "maxLength": 12000
              }
            },
            "required": [
              "role",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "create_access_request",
              "escalate_to_buddy",
              "update_task_status"
            ]
          },
          "uniqueItems": true
        },
        "knowledge_scope": {
          "const": "demo_public"
        },
        "action_results": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/ActionResult"
          }
        }
      },
      "required": [
        "run_id",
        "user",
        "conversation_id",
        "task",
        "messages",
        "allowed_tools",
        "knowledge_scope",
        "action_results"
      ],
      "additionalProperties": false
    },
    "DemoLogin": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "enum": [
            "intern-a",
            "intern-b",
            "buddy-a",
            "buddy-b"
          ]
        }
      },
      "required": [
        "account_id"
      ],
      "additionalProperties": false
    },
    "TaskPatch": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "status",
        "version"
      ],
      "additionalProperties": false
    },
    "Reply": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "answer"
      ],
      "additionalProperties": false
    },
    "AccessRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "access_level": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "mock_id": {
          "type": "string",
          "pattern": "^ACC-[0-9a-f-]{36}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "submitted",
            "approved",
            "rejected"
          ]
        },
        "sync_status": {
          "type": "string",
          "enum": [
            "ok",
            "unavailable"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "task_id",
        "resource",
        "access_level",
        "reason",
        "mock_id",
        "status",
        "sync_status",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "Escalation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "intern": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "id",
            "display_name"
          ],
          "additionalProperties": false
        },
        "buddy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "id",
            "display_name"
          ],
          "additionalProperties": false
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "answer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "resolved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "intern",
        "buddy",
        "task_id",
        "question",
        "summary",
        "source_ids",
        "status",
        "answer",
        "created_at",
        "resolved_at"
      ],
      "additionalProperties": false
    },
    "KnowledgeDocument": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "visibility": {
          "const": "demo_public"
        },
        "synthetic": {
          "const": true
        }
      },
      "required": [
        "id",
        "title",
        "content",
        "version",
        "visibility",
        "synthetic"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          },
          "required": [
            "code",
            "message",
            "request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "SSEDelta": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100000
        }
      },
      "required": [
        "run_id",
        "text"
      ],
      "additionalProperties": false
    },
    "SSEFailure": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "run_id",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "ActionResult": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "create_access_request",
            "escalate_to_buddy",
            "update_task_status"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "unknown"
          ]
        },
        "result": {
          "type": [
            "object",
            "null"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action_id",
        "type",
        "status",
        "result",
        "error_code"
      ],
      "additionalProperties": false
    }
  }
