{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-buddy.invalid/contracts/v4/events.schema.json",
  "title": "Go-owned v4 workflow events; never browser input",
  "$defs": {
    "WorkflowEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "schema_version",
        "occurred_at",
        "received_at",
        "source",
        "entity",
        "correlation_id",
        "payload",
        "synthetic"
      ],
      "properties": {
        "id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "type": {
          "enum": [
            "workspace_linked",
            "proposal_requested",
            "proposal_generated",
            "proposal_applied",
            "proposal_discarded",
            "brief_version_exposed",
            "brief_version_exposure_ended"
          ]
        },
        "schema_version": {
          "const": 1
        },
        "occurred_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        },
        "received_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        },
        "source": {
          "const": "go_v4"
        },
        "entity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "goal",
                "revision_proposal",
                "task_assignment"
              ]
            },
            "id": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
            }
          }
        },
        "correlation_id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assignment_id": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
            },
            "goal_id": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
            },
            "template_id": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"
            },
            "template_version": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
            },
            "brief_id": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
            },
            "report_id": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
            },
            "base_version": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
            },
            "base_revision": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
            },
            "base_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "preview_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "draft_version": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
            },
            "episode_id": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
            },
            "brief_version": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
            },
            "reason": {
              "enum": [
                "assigned",
                "adopted",
                "archived",
                "scope_revoked"
              ]
            },
            "status": {
              "enum": [
                "ready",
                "needs_input",
                "unavailable"
              ]
            },
            "origin": {
              "enum": [
                "model",
                "rule_based"
              ]
            }
          }
        },
        "synthetic": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "workspace_linked"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "assignment_id",
                  "goal_id",
                  "template_id",
                  "template_version"
                ],
                "maxProperties": 4,
                "propertyNames": {
                  "enum": [
                    "assignment_id",
                    "goal_id",
                    "template_id",
                    "template_version"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "proposal_requested"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "brief_id",
                  "report_id",
                  "base_version",
                  "base_revision",
                  "base_hash"
                ],
                "maxProperties": 5,
                "propertyNames": {
                  "enum": [
                    "brief_id",
                    "report_id",
                    "base_version",
                    "base_revision",
                    "base_hash"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "proposal_generated"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "brief_id",
                  "report_id",
                  "status",
                  "origin",
                  "preview_hash"
                ],
                "maxProperties": 5,
                "propertyNames": {
                  "enum": [
                    "brief_id",
                    "report_id",
                    "status",
                    "origin",
                    "preview_hash"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "proposal_applied"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "brief_id",
                  "draft_version",
                  "preview_hash"
                ],
                "maxProperties": 3,
                "propertyNames": {
                  "enum": [
                    "brief_id",
                    "draft_version",
                    "preview_hash"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "proposal_discarded"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "brief_id"
                ],
                "maxProperties": 1,
                "propertyNames": {
                  "enum": [
                    "brief_id"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "brief_version_exposed"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "assignment_id",
                  "brief_id",
                  "brief_version",
                  "episode_id"
                ],
                "maxProperties": 4,
                "propertyNames": {
                  "enum": [
                    "assignment_id",
                    "brief_id",
                    "brief_version",
                    "episode_id"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "brief_version_exposure_ended"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "assignment_id",
                  "reason"
                ],
                "maxProperties": 2,
                "propertyNames": {
                  "enum": [
                    "assignment_id",
                    "reason"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
