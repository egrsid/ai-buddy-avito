{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-buddy.invalid/contracts/v4/ai.schema.json",
  "title": "AI-buddy v4 internal Go <-> Python: revision draft for a mentor task brief (proposal for G1)",
  "description": "POST /internal/v4/revision-draft. Go sends one own task clarity report and only the permitted brief fields with their SHA-256 hashes; Python returns bounded replacements, questions or no change. Python never writes app data. Semantic rules that JSON Schema cannot express are listed in docs/v4/features/ai-revision-editor/contract-ai.md and enforced by ai-service and tests/test_contracts_v4_ai.py.",
  "$defs": {
    "FieldPath": {
      "description": "Allowlisted editable brief field. No arbitrary JSON Patch: only goal, expected result, one section text or one acceptance criterion text.",
      "type": "string",
      "maxLength": 100,
      "pattern": "^(goal|expected_result|(sections|acceptance_criteria)/[a-z][a-z0-9_-]{0,63}/text)$"
    },
    "ReportSectionId": {
      "description": "Report section: a section StableId or the reserved goal / expected_result / acceptance_criteria (same as v3 frictions).",
      "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"
    },
    "ClarityReason": {
      "enum": ["requirement_unclear", "outcome_unclear", "acceptance_unclear"]
    },
    "BriefField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "label", "text", "hash"],
      "properties": {
        "path": {"$ref": "#/$defs/FieldPath"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "hash": {
          "description": "SHA-256 hex of text in UTF-8, computed by Go from the base revision.",
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Sha256"
        }
      }
    },
    "AllowedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "version", "title"],
      "properties": {
        "document_id": {"$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"},
        "version": {"$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "version"],
      "properties": {
        "document_id": {"$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"},
        "version": {"$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"}
      }
    },
    "AuthorAnswer": {
      "description": "Author's answer to an earlier needs_input question. A new generation; the earlier proposal is not overwritten.",
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 500},
        "answer": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "RevisionDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief_title", "base_version", "base_hash", "report", "fields", "refs"],
      "properties": {
        "brief_title": {"type": "string", "minLength": 1, "maxLength": 160},
        "base_version": {"$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"},
        "base_hash": {
          "description": "Content hash of the base (published version or concrete draft revision). Echoed back unchanged.",
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Sha256"
        },
        "report": {
          "description": "Safe aggregate of one task clarity report of the same brief version. No intern IDs, names, chat or logs.",
          "type": "object",
          "additionalProperties": false,
          "required": ["section_id", "reason", "affected_count"],
          "properties": {
            "section_id": {"$ref": "#/$defs/ReportSectionId"},
            "reason": {"$ref": "#/$defs/ClarityReason"},
            "affected_count": {"type": "integer", "minimum": 2, "maximum": 100},
            "hypothesis": {"type": "string", "minLength": 1, "maxLength": 2000}
          }
        },
        "fields": {
          "description": "The reported field and minimal neighbouring criteria. Unique paths; at least one belongs to the reported section.",
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/BriefField"}
        },
        "refs": {
          "description": "Documents the author may read and the brief already references. Python may cite only these.",
          "type": "array",
          "maxItems": 5,
          "items": {"$ref": "#/$defs/AllowedRef"}
        },
        "answers": {
          "type": "array",
          "maxItems": 10,
          "items": {"$ref": "#/$defs/AuthorAnswer"}
        }
      }
    },
    "RevisionChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "label", "old_hash", "replacement", "rationale"],
      "properties": {
        "id": {"$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"},
        "path": {"$ref": "#/$defs/FieldPath"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "old_hash": {
          "description": "Equals hash of the request field with the same path.",
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Sha256"
        },
        "replacement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "RevisionQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"},
        "text": {"type": "string", "minLength": 1, "maxLength": 500},
        "path": {"$ref": "#/$defs/FieldPath"}
      }
    },
    "RevisionDraftOrigin": {
      "description": "Who produced the draft. offline = explicit deterministic template, never presented as a model answer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "answered_by"],
      "properties": {
        "mode": {"enum": ["live", "mock"]},
        "answered_by": {"enum": ["primary", "secondary", "offline"]},
        "reason_code": {
          "enum": ["config_mock", "cooldown", "timeout", "model_unavailable", "budget_denied", "invalid_output"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"answered_by": {"const": "offline"}}},
          "then": {"required": ["reason_code"]},
          "else": {"not": {"required": ["reason_code"]}}
        },
        {
          "if": {"properties": {"mode": {"const": "mock"}}},
          "then": {"properties": {"answered_by": {"const": "offline"}, "reason_code": {"const": "config_mock"}}}
        }
      ]
    },
    "RevisionDraftResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "base_version", "base_hash", "changes", "questions", "rationale", "evidence_refs", "origin"],
      "properties": {
        "outcome": {
          "description": "ready: at least one change; needs_input: at least one question, the author must answer; no_change: text is clear enough, nothing proposed.",
          "enum": ["ready", "needs_input", "no_change"]
        },
        "base_version": {"$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"},
        "base_hash": {"$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Sha256"},
        "changes": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/RevisionChange"}},
        "questions": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/RevisionQuestion"}},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_refs": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/EvidenceRef"}},
        "origin": {"$ref": "#/$defs/RevisionDraftOrigin"}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "ready"}}},
          "then": {"properties": {"changes": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "needs_input"}}},
          "then": {"properties": {"questions": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "no_change"}}},
          "then": {"properties": {"changes": {"maxItems": 0}, "questions": {"maxItems": 0}}}
        }
      ]
    }
  }
}
