{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-buddy.invalid/contracts/v3/public.schema.json",
  "title": "AI-buddy v3 public API additions (Telegram contact, task briefs, task clarity, goal summaries, statistics)",
  "$defs": {
    "TelegramUrl": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^https://t\\.me/[A-Za-z][A-Za-z0-9_]{4,31}$"
    },
    "PersonRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name"
      ],
      "properties": {
        "id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "InternList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/PersonRef"
          }
        }
      }
    },
    "MentorContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "missing"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "telegram_url": {
          "$ref": "#/$defs/TelegramUrl"
        },
        "contact_revision": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "display_name",
              "telegram_url",
              "contact_revision"
            ]
          },
          "else": {
            "properties": {
              "display_name": false,
              "telegram_url": false,
              "contact_revision": false
            }
          }
        }
      ]
    },
    "Question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "ContactPreviewRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goal_id",
            "step_id"
          ],
          "properties": {
            "goal_id": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
            },
            "step_id": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"
            },
            "question": {
              "$ref": "#/$defs/Question"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assignment_id"
          ],
          "properties": {
            "assignment_id": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
            },
            "section_id": {
              "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"
            },
            "question": {
              "$ref": "#/$defs/Question"
            }
          }
        }
      ]
    },
    "ContactPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "content_hash",
        "contact_revision",
        "telegram_url",
        "expires_at"
      ],
      "properties": {
        "id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "content_hash": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Sha256"
        },
        "contact_revision": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "telegram_url": {
          "$ref": "#/$defs/TelegramUrl"
        },
        "expires_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "ContactExportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_id",
        "content_hash",
        "contact_revision"
      ],
      "properties": {
        "preview_id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "content_hash": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Sha256"
        },
        "contact_revision": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        }
      }
    },
    "ContactExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "telegram_url"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "telegram_url": {
          "$ref": "#/$defs/TelegramUrl"
        }
      }
    },
    "BriefSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "AcceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "BriefContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "goal",
        "sections",
        "expected_result",
        "acceptance_criteria",
        "refs"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/BriefSection"
          }
        },
        "expected_result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "acceptance_criteria": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/AcceptanceCriterion"
          }
        },
        "refs": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/InstructionRef"
          }
        }
      }
    },
    "BriefState": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "BriefVersionState": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "TaskBriefVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_id",
        "version",
        "state",
        "content",
        "content_hash",
        "created_at"
      ],
      "properties": {
        "brief_id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "state": {
          "$ref": "#/$defs/BriefVersionState"
        },
        "content": {
          "$ref": "#/$defs/BriefContent"
        },
        "content_hash": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Sha256"
        },
        "created_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        },
        "published_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "published"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "published_at"
            ]
          },
          "else": {
            "properties": {
              "published_at": false
            }
          }
        }
      ]
    },
    "VersionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "state"
      ],
      "properties": {
        "version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "state": {
          "$ref": "#/$defs/BriefVersionState"
        },
        "published_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "TaskBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "state",
        "latest_published_version",
        "draft",
        "versions",
        "assignment_count",
        "open_report_count",
        "revision",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "state": {
          "$ref": "#/$defs/BriefState"
        },
        "latest_published_version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/TaskBriefVersion"
            }
          ]
        },
        "draft": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/TaskBriefVersion"
            }
          ]
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/VersionSummary"
          }
        },
        "assignment_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "open_report_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "revision": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "created_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "TaskBriefList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/TaskBrief"
          }
        }
      }
    },
    "TaskBriefCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/BriefContent"
        }
      }
    },
    "TaskBriefDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "expected_revision"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/BriefContent"
        },
        "expected_revision": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        }
      }
    },
    "RevisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_revision"
      ],
      "properties": {
        "expected_revision": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        }
      }
    },
    "TaskAssignmentCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_id",
        "brief_version",
        "intern_id"
      ],
      "properties": {
        "brief_id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "brief_version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "intern_id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        }
      }
    },
    "TaskAssignmentAdoptRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_version",
        "expected_revision"
      ],
      "properties": {
        "brief_version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "expected_revision": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        }
      }
    },
    "FrictionReason": {
      "enum": [
        "requirement_unclear",
        "outcome_unclear",
        "acceptance_unclear"
      ]
    },
    "TaskAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "brief_id",
        "brief_version",
        "brief_state",
        "latest_published_version",
        "content",
        "intern",
        "author",
        "reported_sections",
        "verification",
        "revision",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "brief_id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "brief_version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "brief_state": {
          "$ref": "#/$defs/BriefState"
        },
        "latest_published_version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "content": {
          "$ref": "#/$defs/BriefContent"
        },
        "intern": {
          "$ref": "#/$defs/PersonRef"
        },
        "author": {
          "$ref": "#/$defs/PersonRef"
        },
        "reported_sections": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_id",
              "reason"
            ],
            "properties": {
              "section_id": {
                "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"
              },
              "reason": {
                "$ref": "#/$defs/FrictionReason"
              }
            }
          }
        },
        "verification": {
          "const": "not_verified"
        },
        "revision": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "created_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        },
        "db_route_enabled": {
          "type": "boolean"
        }
      }
    },
    "TaskAssignmentList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/TaskAssignment"
          }
        }
      }
    },
    "FrictionCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "reason"
      ],
      "properties": {
        "section_id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"
        },
        "reason": {
          "$ref": "#/$defs/FrictionReason"
        }
      }
    },
    "FrictionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "assignment_id",
        "brief_version",
        "section_id",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "recorded",
            "already_recorded"
          ]
        },
        "assignment_id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "brief_version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "section_id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"
        },
        "reason": {
          "$ref": "#/$defs/FrictionReason"
        }
      }
    },
    "TaskClarityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "brief_id",
        "brief_title",
        "brief_version",
        "latest_published_version",
        "section_id",
        "section_title",
        "reason",
        "state",
        "current_count",
        "lifetime_count",
        "last_seen_at",
        "hypothesis",
        "suggestion",
        "enrichment_status",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "brief_id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Uuid"
        },
        "brief_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "brief_version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "latest_published_version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "section_id": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/StableId"
        },
        "section_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "reason": {
          "$ref": "#/$defs/FrictionReason"
        },
        "state": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/CandidateState"
        },
        "current_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "lifetime_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "last_seen_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "suggestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "enrichment_status": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/EnrichmentStatus"
        },
        "resolved_version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "created_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "resolved"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "resolved_version"
            ]
          },
          "else": {
            "properties": {
              "resolved_version": false
            }
          }
        }
      ]
    },
    "TaskClarityReportList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/TaskClarityReport"
          }
        }
      }
    },
    "TaskClarityReviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason",
        "expected_version"
      ],
      "properties": {
        "decision": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/ReviewDecision"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "expected_version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        },
        "resolved_version": {
          "$ref": "https://ai-buddy.invalid/contracts/v2/common.schema.json#/$defs/PositiveInt"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "resolved"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "resolved_version"
            ]
          },
          "else": {
            "properties": {
              "resolved_version": false
            }
          }
        }
      ]
