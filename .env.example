# Local synthetic environment only. Never reuse these passwords outside local development.
APP_ENV=local
APP_ORIGIN=http://localhost:5173
BACKEND_PORT=8080
FRONTEND_PORT=5173
POSTGRES_DB=buddy
POSTGRES_USER=buddy_admin
POSTGRES_PASSWORD=local_admin_only
APP_DB_PASSWORD=local_app_only
AI_DB_PASSWORD=local_ai_only
MOCK_DB_PASSWORD=local_mock_only
INTERNAL_API_TOKEN=local-dev-token-replace-before-sharing
LLM_MODE=mock
# Live: LLM_MODE=live + провайдер. ollama — локальная модель, openai — Cloud.ru (/v1).
# Ollama из контейнера: LLM_BASE_URL=http://host.docker.internal:11434, LLM_MODEL=qwen3.5:9b
# Cloud.ru: LLM_PROVIDER=openai, LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1,
#   LLM_MODEL=GigaChat/GigaChat-3-Pro, EMBEDDING_MODEL=BAAI/bge-m3, ключ — в LLM_API_KEY.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
# Ordered failover on the same Cloud.ru endpoint, then deterministic offline help.
LLM_FALLBACK_MODEL=ai-sage/GigaChat3.5-432B-A28B
# Verify both models' tariffs in your account before enabling paid calls.
LLM_FALLBACK_PRICE_INPUT_RUB=96.22
LLM_FALLBACK_PRICE_OUTPUT_RUB=288.60
LLM_API_KEY=
LLM_NUM_CTX=
LLM_MAX_OUTPUT_TOKENS=
LLM_KEEP_ALIVE=
LLM_REASONING_EFFORT=
EMBEDDING_MODEL=
EMBEDDING_DIM=
# off — поиск по вопросу только лексический: ответ быстрее на время эмбеддинга (до 3 с).
QUERY_EMBEDDINGS=off
# Только для LLM_PROVIDER=openai: тарифы (₽ за 1 млн токенов, каталог Cloud.ru 2026-11-12)
# и автостоп расходов. Без тарифов live с платным API не стартует.
LLM_BUDGET_STOP_RUB=800
LLM_PRICE_INPUT_RUB=73.03
LLM_PRICE_OUTPUT_RUB=176.39
EMBEDDING_PRICE_RUB=0.61
# Target acceptance overlay. AI Engineer supplies JSON argv arrays for the real CLI/tests.
AI_INGEST_COMMAND=["python","-m","app.ingest"]
AI_DB_TEST_COMMAND=["python","-m","pytest","ai-service/tests/test_kb_integration.py","-q"]
MOCK_FAULTS_ENABLED=false
AI_MOCK_SCENARIO=normal
