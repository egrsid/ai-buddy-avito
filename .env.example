# Local synthetic environment only. Never reuse these passwords outside local development.
APP_ENV=local
# Explicit v2 app/corporate dataset requires a fresh project; compose.mvp.yaml selects v2.
SEED_DATASET=legacy
APP_ORIGIN=http://localhost:5173
BACKEND_PORT=8080
FRONTEND_PORT=5173
POSTGRES_DB=buddy
POSTGRES_USER=buddy_admin
POSTGRES_PASSWORD=local_admin_only
APP_DB_PASSWORD=local_app_only
AI_DB_PASSWORD=local_ai_only
MOCK_DB_PASSWORD=local_mock_only
INTERNAL_API_TOKEN=local-dev-token-replace-before-sharing
LLM_MODE=mock
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=
# Target acceptance overlay. AI Engineer supplies JSON argv arrays for the real CLI/tests.
AI_INGEST_COMMAND=
AI_DB_TEST_COMMAND=
MOCK_FAULTS_ENABLED=false
AI_MOCK_SCENARIO=normal
